{
  "name": "whiteboard",
  "version": "1.0.0",
  "description": "Vet clinic whiteboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build": "electron-builder --win"
  },
  "keywords": [],
